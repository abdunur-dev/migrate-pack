{
  "name": "migrate-pack",
  "version": "0.1.2",
  "description": "Migrate Express 4 code to Express 5 using a YAML rules file. AST edits with ts-morph; ambiguous cases are reported, not guessed.",
  "license": "MIT",
  "author": "Abdurhaman Nur",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdunur-dev/migrate-pack.git"
  },
  "homepage": "https://github.com/abdunur-dev/migrate-pack#readme",
  "bugs": {
    "url": "https://github.com/abdunur-dev/migrate-pack/issues"
  },
  "keywords": [
    "express",
    "express5",
    "migration",
    "codemod",
    "ts-morph",
    "ast",
    "cli"
  ],
  "bin": {
    "migrate-pack": "dist/cli.js"
  },
  "files": [
    "dist",
    "rules.yaml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "test": "node --import tsx --test test/app-del.test.ts test/renames.test.ts test/reorder-args.test.ts test/manual.test.ts test/cli.test.ts test/runTests.test.ts test/suggest.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "diff": "^8.0.2",
    "ts-morph": "^24.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
